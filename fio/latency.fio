; single-outstanding-IO latency test with full completion-latency percentiles
[global]
ioengine=libaio
direct=1
directory=${TARGET}
filename=bench.file
size=${SIZE}
randrepeat=0
norandommap=1
group_reporting=1
time_based=1
runtime=${RUNTIME}
ramp_time=2
lat_percentiles=1
clat_percentiles=1
percentile_list=50:90:95:99:99.9:99.99
[${JOBNAME}]
rw=randread
bs=4k
iodepth=1
numjobs=1

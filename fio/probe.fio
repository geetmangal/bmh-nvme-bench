; 5-second 4k QD1 latency sample used by the noisy-neighbour probe loop
[global]
ioengine=libaio
direct=1
directory=${TARGET}
filename=bench.file
size=${SIZE}
randrepeat=0
norandommap=1
group_reporting=1
time_based=1
runtime=${RUNTIME}
lat_percentiles=1
percentile_list=50:99:99.9
[${JOBNAME}]
rw=randread
bs=4k
iodepth=1
numjobs=1

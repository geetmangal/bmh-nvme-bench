; random 4k read / write; RW=randread|randwrite, IODEPTH=1|32|64, NUMJOBS from profile
[global]
ioengine=libaio
direct=1
directory=${TARGET}
filename=bench.file
size=${SIZE}
randrepeat=0
norandommap=1
group_reporting=1
time_based=1
runtime=${RUNTIME}
ramp_time=2
[${JOBNAME}]
rw=${RW}
bs=${BS}
iodepth=${IODEPTH}
numjobs=${NUMJOBS}
